{% comment %}RRUK homepage decision router. Add below the primary hero.{% endcomment %}
<section class="rruk-router" aria-labelledby="rruk-router-title">
  <div class="rruk-router__inner">
    <p class="rruk-router__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 id="rruk-router-title">{{ section.settings.heading | escape }}</h2>
    <div class="rruk-router__grid">
      <a class="rruk-router__card" href="{{ section.settings.shop_url }}"><strong>SHOP RETRO</strong><span>I know what I want</span></a>
      <a class="rruk-router__card" href="{{ section.settings.gift_url }}"><strong>GIFT FINDER</strong><span>I’m buying for someone</span></a>
      <a class="rruk-router__card" href="{{ section.settings.checker_url }}"><strong>CONSOLE CHECKER</strong><span>I’m researching a console</span></a>
      <a class="rruk-router__card" href="{{ section.settings.hunt_url }}"><strong>CONSOLE HUNT</strong><span>I can’t find what I want</span></a>
      <a class="rruk-router__card" href="{{ section.settings.value_url }}"><strong>SELL OR VALUE</strong><span>I have something to sell</span></a>
    </div>
  </div>
</section>
<style>
#shopify-section-{{ section.id }} .rruk-router{background:#020f32;color:#fff;padding:clamp(32px,6vw,68px) 20px;border-block:3px solid #00a8ff}
#shopify-section-{{ section.id }} .rruk-router__inner{max-width:1200px;margin:auto}
#shopify-section-{{ section.id }} .rruk-router__eyebrow{color:#16d5ff;font:800 14px "Courier New",monospace;letter-spacing:.12em;margin:0}
#shopify-section-{{ section.id }} h2{color:#ffd326;font:900 clamp(28px,5vw,48px) "Courier New",monospace;text-transform:uppercase;margin:8px 0 24px}
#shopify-section-{{ section.id }} .rruk-router__grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
#shopify-section-{{ section.id }} .rruk-router__card{background:#061b49;color:#fff;border:2px solid #087dcc;padding:20px 16px;text-decoration:none;min-height:128px;display:flex;flex-direction:column;justify-content:center;transition:.15s ease}
#shopify-section-{{ section.id }} .rruk-router__card:hover,#shopify-section-{{ section.id }} .rruk-router__card:focus-visible{border-color:#ffd326;transform:translateY(-2px);outline:3px solid rgba(255,211,38,.35)}
#shopify-section-{{ section.id }} .rruk-router__card strong{color:#ffd326;font:900 16px "Courier New",monospace}
#shopify-section-{{ section.id }} .rruk-router__card span{margin-top:8px;line-height:1.35}
@media(max-width:990px){#shopify-section-{{ section.id }} .rruk-router__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){#shopify-section-{{ section.id }} .rruk-router__grid{grid-template-columns:1fr}#shopify-section-{{ section.id }} .rruk-router__card{min-height:auto}}
</style>
{% schema %}
{"name":"RRUK income router","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FIND YOUR FASTEST ROUTE"},{"type":"text","id":"heading","label":"Heading","default":"WHAT BRINGS YOU TO RRUK?"},{"type":"text","id":"shop_url","label":"Shop URL","default":"/collections/all"},{"type":"text","id":"gift_url","label":"Gift Finder URL","default":"https://taccountant2026.github.io/Retro-Gift-Finder/?utm_source=rruk_home&utm_campaign=income_router#finder"},{"type":"text","id":"checker_url","label":"Console Checker URL","default":"https://taccountant2026.github.io/Retro-Gift-Finder/console-checker/?utm_source=rruk_home&utm_campaign=income_router"},{"type":"text","id":"hunt_url","label":"Console Hunt URL","default":"https://taccountant2026.github.io/Retro-Gift-Finder/console-hunt/?utm_source=rruk_home&utm_campaign=income_router"},{"type":"text","id":"value_url","label":"Valuation URL","default":"https://taccountant2026.github.io/Retro-Gift-Finder/sell-value/?utm_source=rruk_home&utm_campaign=income_router"}],"presets":[{"name":"RRUK income router"}]}
{% endschema %}
