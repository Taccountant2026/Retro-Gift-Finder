{% comment %}Optional post-support contribution. Disabled by default and hidden without a payment URL.{% endcomment %}
{% if section.settings.enabled and section.settings.payment_url != blank %}
<section class="rruk-thanks" aria-labelledby="rruk-thanks-title-{{ section.id }}">
  <div class="rruk-thanks__icon" aria-hidden="true">♥</div>
  <div>
    <h2 id="rruk-thanks-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.copy | escape }}</p>
    <p class="rruk-thanks__note">Completely optional. It does not affect your order, warranty, returns, support or any future service.</p>
  </div>
  <a href="{{ section.settings.payment_url }}" rel="noopener" class="rruk-thanks__button">{{ section.settings.button_label | escape }}</a>
</section>
<style>
#shopify-section-{{ section.id }} .rruk-thanks{max-width:1100px;margin:24px auto;padding:22px;display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;background:#061b49;color:#fff;border:2px solid #16d5ff}
#shopify-section-{{ section.id }} .rruk-thanks__icon{font-size:38px;color:#ff493e}
#shopify-section-{{ section.id }} .rruk-thanks h2{color:#ffd326;font:900 clamp(20px,4vw,28px) "Courier New",monospace;text-transform:uppercase;margin:0 0 8px}
#shopify-section-{{ section.id }} .rruk-thanks p{margin:5px 0}
#shopify-section-{{ section.id }} .rruk-thanks__note{font-size:13px;color:#b8c9e8}
#shopify-section-{{ section.id }} .rruk-thanks__button{background:#ffd326;color:#051334;border-bottom:4px solid #dc8f00;padding:12px 16px;text-decoration:none;font:900 13px "Courier New",monospace;text-align:center}
#shopify-section-{{ section.id }} .rruk-thanks__button:focus-visible{outline:3px solid #fff;outline-offset:3px}
@media(max-width:700px){#shopify-section-{{ section.id }} .rruk-thanks{grid-template-columns:1fr;text-align:center}}
</style>
{% endif %}
{% schema %}
{"name":"RRUK optional thanks","settings":[{"type":"checkbox","id":"enabled","label":"Show optional contribution","default":false},{"type":"text","id":"heading","label":"Heading","default":"HELPED YOU OUT?"},{"type":"text","id":"copy","label":"Message","default":"If my help saved you time or got you playing again, you can optionally support the work behind RetroReplay UK."},{"type":"url","id":"payment_url","label":"Approved payment URL"},{"type":"text","id":"button_label","label":"Button label","default":"LEAVE AN OPTIONAL THANK YOU"}],"presets":[{"name":"RRUK optional thanks"}]}
{% endschema %}